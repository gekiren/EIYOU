{
  "expo": {
    "name": "EIYOU",
    "slug": "eiyou",
    "owner": "gekirennomads-organization",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gekiren.eiyou"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.gekiren.eiyou",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "40d3122e-aa40-4c58-a7a2-86e180420480"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/40d3122e-aa40-4c58-a7a2-86e180420480"
    },
    "runtimeVersion": "1.0.0",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "食事や栄養成分表示ラベルの写真を撮影・選択するために写真ライブラリへのアクセスを使用します。",
          "cameraPermission": "食事や栄養成分表示ラベルを撮影するためにカメラを使用します。"
        }
      ]
    ]
  }
}
